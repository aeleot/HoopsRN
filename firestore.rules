rules_version = '2';

// hoopsRN Firestore security rules.
//
// Seven collections, in increasing order of who may write them:
// `users` (one owner per document), `games` (the first shared, multi-user
// state in the app), `friendships` (one document per pair of people, written
// by either of them), `squads` (a team, written by its leader and by each
// member for their own membership), `squadInvites` (one document per
// squad-and-person pair, structurally `friendships`), and finally
// `matchTickets` and `seasonGames` — which are written *together*, by one
// transaction that spends both squads' tickets and creates the match, and are
// the only documents here whose contested write is another squad's. See
// `context/database/DATABASE_SCHEMA.md`.
//
// SEVERAL VALUES HERE ARE MIRRORED IN SWIFT — the roster bounds, the
// scheduling window, the radius range, the `userName` length, the derivation
// of `status` from the roster, on `squads` the name length, the roster
// ceiling per format, the format allowlist and the icon/colour allowlists, and
// on `matchTickets` the court-count bounds and the ticket lifetime.
// `hooprTests/FirestoreRulesParityTests` parses this file and fails if either
// copy moves without the other. Change a bound here and change it there; a
// mismatch doesn't show up as a logic error, it shows up as
// `permission-denied` on every affected write.
service cloud.firestore {
  match /databases/{database}/documents {

    // One profile per account, document ID == Firebase Auth uid.
    //
    // Readable by any signed-in user, because player names have to be
    // resolvable in shared contexts (match rosters, court check-ins) later.
    // Writable only by the account that owns it.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read: if request.auth != null;

      // The key allowlist is what keeps this document safe to leave world-
      // readable. Without it a modified client could store anything it liked
      // on its own profile — an email, a phone number — and every other
      // signed-in user could read it, because Firestore has no field-level
      // read ACLs. `email` was exactly that mistake: written at provisioning,
      // read by nothing, visible to everyone. Anything private belongs in an
      // owner-only subcollection, never here.
      //
      // The update rule below has always had this; create didn't, which left
      // the field-level contract enforced only after the first write.
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['id', 'userName', 'userNameLower',
                                                 'homeCourtId', 'preferredRadius',
                                                 'favoriteCourtIds',
                                                 'createdAt', 'updatedAt'])
        && request.resource.data.id == uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 50;

      // Enforces the mutability contract: `id` and `createdAt` are
      // write-once, and a client may only ever touch the user-editable fields
      // (plus the `updatedAt` bookkeeping). Anything else is rejected
      // server-side, including a hand-crafted request.
      //
      // `homeCourtId` may also be removed entirely (clearing a home court),
      // which is why its type check tolerates the field being absent.
      allow update: if isOwner()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['userName', 'userNameLower', 'homeCourtId',
                       'preferredRadius', 'favoriteCourtIds', 'updatedAt'])
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 50
        && (!('homeCourtId' in request.resource.data)
            || request.resource.data.homeCourtId is string)
        && (!('preferredRadius' in request.resource.data)
            || (request.resource.data.preferredRadius is number
                && request.resource.data.preferredRadius >= 1
                && request.resource.data.preferredRadius <= 50))
        // Written via arrayUnion/arrayRemove, so it's absent on profiles
        // provisioned before favourites existed — the type check tolerates
        // that the same way `homeCourtId`'s does.
        && (!('favoriteCourtIds' in request.resource.data)
            || request.resource.data.favoriteCourtIds is list);

      // Participation stats, recalculated and written back by the profile's
      // own owner after their completed-games listener delivers a snapshot —
      // see `UserProfileService.refreshStats`. A separate path from the
      // profile-edit path above, the same way the two `games` update paths
      // are separate, so a stats sync can't also smuggle in a `userName`
      // change and vice versa.
      //
      // There's no backend here to recompute these server-side — no Cloud
      // Function, no admin service account — so this is trusted the same way
      // `userNameLower`'s self-backfill already is: a modified client could
      // misreport its own stats, which is the same ceiling the rest of
      // `users/{uid}` already accepts. "Service-only" describes the app's own
      // logic writing these three fields as a unit, not a distinct identity.
      allow update: if isOwner()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['completedGameCount', 'participationStreak',
                       'lastCompletedAt', 'updatedAt'])
        && (!('completedGameCount' in request.resource.data)
            || (request.resource.data.completedGameCount is int
                && request.resource.data.completedGameCount >= 0))
        && (!('participationStreak' in request.resource.data)
            || (request.resource.data.participationStreak is int
                && request.resource.data.participationStreak >= 0))
        && (!('lastCompletedAt' in request.resource.data)
            || request.resource.data.lastCompletedAt is timestamp);

      // Account deletion isn't a supported flow yet.
      allow delete: if false;
    }

    // A scheduled run at a court. Unlike `users`, these documents are written
    // by more than one person: the host creates and cancels, every other
    // player only ever adds or removes *themselves* from the two rosters.
    //
    // Document ID is generated by Firestore; the `id` field mirrors it so the
    // client model decodes without a `@DocumentID` wrapper.
    match /games/{gameId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function incoming() {
        return request.resource.data;
      }

      // Everyone on either roster, as a set. Used to prove that an update
      // changed nobody's membership but the caller's own.
      function members(data) {
        return data.playerIds.toSet().union(data.queuedPlayerIds.toSet());
      }

      // `status` is derived, never chosen: it must agree with the roster it
      // ships alongside, so a client can't store a `full` run with two players
      // in it (or an `open` one with no seats left).
      function statusMatchesRoster() {
        return incoming().status ==
          (incoming().playerIds.size() >= incoming().maxPlayers ? 'full' : 'open');
      }

      // Readable if it's discoverable, or if you're on it. The two client
      // queries are constrained to exactly these shapes — `isPublic == true`,
      // and `playerIds array-contains uid` — so each returns only documents
      // this rule already admits.
      allow read: if isSignedIn()
        && (resource.data.isPublic == true
            || request.auth.uid in resource.data.playerIds
            || request.auth.uid in resource.data.queuedPlayerIds);

      // The host is the only author of a run, and starts as its only player.
      // `createdAt`/`updatedAt` are pinned to `request.time`, which is how a
      // server timestamp is *enforced* rather than merely requested — a
      // hand-crafted request can't backdate a run.
      allow create: if isSignedIn()
        && incoming().keys().hasOnly(['id', 'hostId', 'courtId', 'scheduledTime',
                                      'isPublic', 'maxPlayers', 'status',
                                      'playerIds', 'queuedPlayerIds',
                                      'createdAt', 'updatedAt'])
        && incoming().keys().hasAll(['id', 'hostId', 'courtId', 'scheduledTime',
                                     'isPublic', 'maxPlayers', 'status',
                                     'playerIds', 'queuedPlayerIds',
                                     'createdAt', 'updatedAt'])
        && incoming().id == gameId
        && incoming().hostId == request.auth.uid
        && incoming().courtId is string
        && incoming().courtId.size() > 0
        && incoming().isPublic is bool
        && incoming().maxPlayers is int
        && incoming().maxPlayers >= 2
        && incoming().maxPlayers <= 30
        // Bounded on both sides: no runs in the past, none parked a year out.
        && incoming().scheduledTime is timestamp
        && incoming().scheduledTime > request.time
        && incoming().scheduledTime < request.time + duration.value(30, 'd')
        && incoming().playerIds == [request.auth.uid]
        && incoming().queuedPlayerIds == []
        && statusMatchesRoster()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Joining and leaving, and nothing else. Every field that describes the
      // run itself — court, time, visibility, size, host — is immutable, so
      // there is no "edit a run" path to secure.
      //
      // The membership diff is the load-bearing check: whoever is calling may
      // appear or disappear across the two rosters, and no one else may move.
      // That's also why a freed slot isn't handed to the first waitlisted
      // player — promoting someone means writing *their* uid, which this
      // rejects by design.
      allow update: if isSignedIn()
        && incoming().diff(resource.data).affectedKeys()
             .hasOnly(['playerIds', 'queuedPlayerIds', 'status', 'updatedAt'])
        && incoming().playerIds is list
        && incoming().queuedPlayerIds is list
        && incoming().playerIds.size() <= resource.data.maxPlayers
        // No repeats. Without this, the membership diff below — which compares
        // *sets* — reads a roster of ['me', 'me', 'me'] as no change at all,
        // letting one player consume every seat and lock a run to `full`.
        && incoming().playerIds.toSet().size() == incoming().playerIds.size()
        && incoming().queuedPlayerIds.toSet().size() == incoming().queuedPlayerIds.size()
        // The host can't leave their own run; cancelling is their exit.
        && incoming().playerIds.hasAll([resource.data.hostId])
        // Rosters stay disjoint — nobody is confirmed and waitlisted at once.
        && incoming().playerIds.toSet().intersection(incoming().queuedPlayerIds.toSet()).size() == 0
        && members(incoming()).difference(members(resource.data)).hasOnly([request.auth.uid])
        && members(resource.data).difference(members(incoming())).hasOnly([request.auth.uid])
        // Only a live run takes players, and it stays consistent afterwards.
        && resource.data.status in ['open', 'full']
        && statusMatchesRoster()
        && incoming().updatedAt == request.time;

      // Marking a run complete. Host-only, and a separate path from the
      // roster changes above: this write only ever touches
      // `completedAt`/`status`, the roster write only ever touches
      // `playerIds`/`queuedPlayerIds`/`status`, and neither has to tolerate
      // the other's fields. `completedAt` is pinned to `request.time` the
      // same way `createdAt`/`updatedAt` are on create — enforced, not
      // merely requested — so a completion can't be backdated to inflate a
      // participation streak. There's no way to record who won, so this is
      // the only signal a completion carries — attendance, nothing more.
      allow update: if isSignedIn()
        && resource.data.hostId == request.auth.uid
        && resource.data.status != 'completed'
        && incoming().diff(resource.data).affectedKeys()
             .hasOnly(['completedAt', 'status', 'updatedAt'])
        && incoming().status == 'completed'
        && incoming().completedAt == request.time
        && incoming().updatedAt == request.time;

      // Cancelling is the host's alone. Unlike `users`, deletion is a
      // first-class action here — a run that can't be called off would sit in
      // everyone's list until it aged out.
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;
    }

    // A friendship, or a request to become one. Like `games`, written by two
    // different people; unlike `games`, the authority is asymmetric and spent
    // in one move — the requester creates the document, and the only thing the
    // other participant may ever do to it is accept.
    //
    // Declining, cancelling and unfriending are all the same operation
    // (delete), which is why there's no `declined` status: absence, never null.
    match /friendships/{friendshipId} {
      function isSignedIn() { return request.auth != null; }
      function incoming() { return request.resource.data; }

      // The two participants, always in a fixed lexicographic order, so a given
      // pair of people can only ever be represented by one document — without
      // this, A could create `A_B` while B independently created `B_A` for the
      // same friendship, and the two copies would drift out of sync.
      function isOrderedPair() {
        return incoming().uidA < incoming().uidB;
      }

      // Ties the document ID to its own content instead of trusting the client
      // to pick a consistent one — the same role `incoming().id == gameId` plays
      // on `games`, just derived instead of client-chosen.
      function idMatchesPair() {
        return friendshipId == incoming().uidA + '_' + incoming().uidB;
      }

      function isParticipant(data) {
        return request.auth.uid == data.uidA || request.auth.uid == data.uidB;
      }

      // A friendship isn't public like `users` or `games` — only the two people
      // on it may know it exists, including while it's still a pending request.
      allow read: if isSignedIn() && isParticipant(resource.data);

      allow create: if isSignedIn()
        && isOrderedPair()
        && idMatchesPair()
        && incoming().keys().hasOnly(['uidA', 'uidB', 'requestedBy', 'status',
                                      'createdAt', 'updatedAt'])
        && incoming().keys().hasAll(['uidA', 'uidB', 'requestedBy', 'status',
                                     'createdAt', 'updatedAt'])
        && incoming().uidA is string && incoming().uidB is string
        && incoming().uidA != incoming().uidB
        // Only the requester may create the edge, and only as one of its own
        // two participants — nobody can fabricate a request on someone else's
        // behalf or insert a third party into a pair they're not part of.
        && incoming().requestedBy == request.auth.uid
        && isParticipant(incoming())
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isParticipant(resource.data)
        // Who the two people are, and who asked, can never change after
        // creation — an update can only ever be the recipient answering.
        && incoming().uidA == resource.data.uidA
        && incoming().uidB == resource.data.uidB
        && incoming().requestedBy == resource.data.requestedBy
        && incoming().diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && resource.data.status == 'pending'
        && incoming().status == 'accepted'
        // The requester already spent their one move by creating the doc; only
        // the *other* participant may move it to accepted.
        && request.auth.uid != resource.data.requestedBy
        && incoming().updatedAt == request.time;

      // Either participant may remove the edge outright. While pending that's
      // the recipient declining or the requester cancelling; once accepted
      // that's either side unfriending — all three are the same operation
      // (delete), distinguished client-side only for wording/logging.
      allow delete: if isSignedIn() && isParticipant(resource.data);
    }

    // A named team that queues together for season matches — the third piece
    // of shared, multi-user state, and the first whose subject is a *group*
    // rather than a person or a pair. That's what makes squad-vs-squad play
    // legal here: a match names two squad IDs, so a leader commits three
    // people by writing one identifier they already own, and nobody's uid is
    // ever written by anybody else. See `context/plans/SEASONS.md` §0.3.
    //
    // Readable by any signed-in user, like `users` and unlike `friendships`.
    // An opponent has to be able to render your crest and name on a match
    // card, and season play is public by design. The key allowlist on create
    // is what keeps that safe — exactly the argument `users` makes: without
    // it, a modified client could store anything it liked on a document every
    // account can read, and Firestore has no field-level read ACLs.
    //
    // **Three separate update paths**, the same split `users` draws between
    // profile edits and stats and `games` draws between roster changes and
    // completion. One write can never smuggle in another path's fields: a
    // leader's rename can't also change the roster, and a join can't also
    // change the name.
    //
    // SEVERAL VALUES HERE ARE MIRRORED IN SWIFT — the name length, the roster
    // ceiling per format, the format allowlist, and the icon/colour
    // allowlists. `hooprTests/FirestoreRulesParityTests` parses this file and
    // fails if either copy moves without the other.
    match /squads/{squadId} {
      function isSignedIn() { return request.auth != null; }
      function incoming() { return request.resource.data; }

      // MIRRORED IN SWIFT — `SquadFormat.available`. The schema carries `1v1`
      // and `5v5` from day one; only what's listed here can actually be
      // created. Adding a format means an entry here *and* a branch in
      // maxRoster() below.
      function isAllowedFormat(format) {
        return format in ['3v3'];
      }

      // MIRRORED IN SWIFT — `SquadFormat.maxRoster`. A side, plus the same
      // number again in substitutes. A format this ruleset doesn't allow gets
      // a ceiling of zero rather than a default, so a roster can never be
      // sized against a format nobody agreed to.
      function maxRoster(format) {
        return format == '3v3' ? 6 : 0;
      }

      // MIRRORED IN SWIFT — `Squad.nameLengthRange`.
      function isValidName(name) {
        return name is string && name.size() >= 3 && name.size() <= 24;
      }

      // MIRRORED IN SWIFT — `Squad.iconKeys`. An SF Symbol name, rendered by
      // everyone who can see the squad, which is everyone.
      function isAllowedIcon(key) {
        return key in ['basketball.fill', 'flame.fill', 'bolt.fill',
                       'crown.fill', 'shield.fill', 'star.fill',
                       'hare.fill', 'tortoise.fill', 'pawprint.fill',
                       'bird.fill', 'mountain.2.fill', 'hexagon.fill'];
      }

      // MIRRORED IN SWIFT — `Squad.colorKeys`. A palette *key*, never a
      // colour: the value is resolved by `Theme.swift` so the crest stays
      // appearance-aware. A stored hex would bypass that entirely.
      function isAllowedColor(key) {
        return key in ['orange', 'red', 'pink', 'purple',
                       'blue', 'teal', 'green', 'gold'];
      }

      // Whoever is calling may appear or disappear from the roster, and no one
      // else may move. The `games` membership idiom verbatim — both
      // directions, because one direction alone would let a caller add
      // themselves while dropping somebody else in the same write.
      function onlyCallerMoved() {
        return incoming().memberIds.toSet()
                 .difference(resource.data.memberIds.toSet())
                 .hasOnly([request.auth.uid])
          && resource.data.memberIds.toSet()
               .difference(incoming().memberIds.toSet())
               .hasOnly([request.auth.uid]);
      }

      function rosterIsWellFormed() {
        return incoming().memberIds is list
          && incoming().memberIds.size() <= maxRoster(resource.data.format)
          // No repeats. Without this, the *set* comparison in
          // onlyCallerMoved() reads a roster of
          // ['leader','me','me','me','me','me'] as a single addition — six
          // list entries, two set entries — letting one member consume every
          // seat and lock the squad to full. The same hole the `games` rule
          // documents, and the reason a set diff is only a faithful proxy for
          // a stored list when the list has no duplicates.
          && incoming().memberIds.toSet().size() == incoming().memberIds.size()
          // The leader can't be removed by anyone, themselves included.
          // Disbanding is their exit, the way cancelling is a `games` host's.
          && incoming().memberIds.hasAll([resource.data.leaderId]);
      }

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && incoming().keys().hasOnly(['id', 'name', 'nameLower', 'leaderId',
                                      'memberIds', 'format', 'iconKey',
                                      'colorKey', 'region',
                                      'createdAt', 'updatedAt'])
        && incoming().keys().hasAll(['id', 'name', 'nameLower', 'leaderId',
                                     'memberIds', 'format', 'iconKey',
                                     'colorKey', 'region',
                                     'createdAt', 'updatedAt'])
        && incoming().id == squadId
        && incoming().leaderId == request.auth.uid
        // A squad starts as its leader alone. Everyone else arrives through
        // the self-join path below — which is what keeps "a client only ever
        // writes its own membership" true from the very first write.
        && incoming().memberIds == [request.auth.uid]
        && isValidName(incoming().name)
        && incoming().nameLower is string
        && isAllowedFormat(incoming().format)
        && isAllowedIcon(incoming().iconKey)
        && isAllowedColor(incoming().colorKey)
        // Deliberately unbounded beyond non-empty: `region` is `Court.city`
        // today and `plans/SCALE_UP.md` S1.1's real region key tomorrow.
        // Mirroring a length for a value already scheduled to change would
        // pin down the one part of this field that isn't decided.
        && incoming().region is string
        && incoming().region.size() > 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // 1. Leader edit — the name and the crest, and nothing else.
      // `memberIds` is absent from the allowlist, so this path cannot change
      // who is on the squad no matter what it ships alongside.
      allow update: if isSignedIn()
        && resource.data.leaderId == request.auth.uid
        && incoming().diff(resource.data).affectedKeys()
             .hasOnly(['name', 'nameLower', 'iconKey', 'colorKey', 'updatedAt'])
        && isValidName(incoming().name)
        && incoming().nameLower is string
        && isAllowedIcon(incoming().iconKey)
        && isAllowedColor(incoming().colorKey)
        && incoming().updatedAt == request.time;

      // 2. Self-join — the caller adds themselves, and only if a leader
      // already invited them. `squadInvites/{squadId}_{uid}` *is* the standing
      // permission, and deriving its document ID from the pair is what makes
      // checking it one exists() rather than a query.
      allow update: if isSignedIn()
        && incoming().diff(resource.data).affectedKeys()
             .hasOnly(['memberIds', 'updatedAt'])
        && rosterIsWellFormed()
        && onlyCallerMoved()
        // Pins the direction: not a member before, a member after. With
        // onlyCallerMoved() above, that leaves exactly one legal diff.
        && !(request.auth.uid in resource.data.memberIds)
        && incoming().memberIds.hasAll([request.auth.uid])
        && exists(/databases/$(database)/documents/squadInvites/$(squadId + '_' + request.auth.uid))
        && incoming().updatedAt == request.time;

      // 3. Self-leave — the mirror image, and closed to the leader.
      allow update: if isSignedIn()
        && incoming().diff(resource.data).affectedKeys()
             .hasOnly(['memberIds', 'updatedAt'])
        && rosterIsWellFormed()
        && onlyCallerMoved()
        && request.auth.uid in resource.data.memberIds
        && !(request.auth.uid in incoming().memberIds)
        // Redundant with rosterIsWellFormed()'s hasAll([leaderId]) and kept
        // anyway: this is the sentence that says *why* a leader can't leave,
        // where the other one only says the leader must still be listed.
        && request.auth.uid != resource.data.leaderId
        && incoming().updatedAt == request.time;

      // Disbanding. The leader's alone, and a first-class action rather than
      // an omission — a squad nobody can dissolve would sit in every member's
      // list forever, the same argument `games` makes for cancellation.
      allow delete: if isSignedIn() && resource.data.leaderId == request.auth.uid;
    }

    // A leader's standing offer for one person to join one squad.
    //
    // Structurally `friendships`: one document per pair, ID derived from its
    // own content, so a duplicate invite is impossible rather than merely
    // deduplicated. The authority is asymmetric and spent in one move — the
    // leader creates it, and the only thing the invitee ever does to *this*
    // document is delete it. Accepting is a write to the squad, not to here,
    // which is the whole reason a squad can gain a member without anyone
    // writing somebody else's uid.
    //
    // Revoking, declining, and consuming an accepted invite are all the same
    // operation (delete), which is why there's no `status` field: absence,
    // never null.
    match /squadInvites/{inviteId} {
      function isSignedIn() { return request.auth != null; }
      function incoming() { return request.resource.data; }

      // Ties the document ID to its own content instead of trusting the client
      // to pick a consistent one — the role idMatchesPair() plays on
      // `friendships`, and the reason there's nothing to deduplicate.
      function idMatchesPair() {
        return inviteId == incoming().squadId + '_' + incoming().uid;
      }

      // The `friendships` document for the inviter and the invitee, computed
      // exactly as `Friendship.id(for:_:)` computes it in Swift: the pair in
      // lexicographic order. Firebase uids are ASCII alphanumeric, so Swift's
      // `<` and this one agree on the ordering.
      function friendshipId() {
        return request.auth.uid < incoming().uid
          ? request.auth.uid + '_' + incoming().uid
          : incoming().uid + '_' + request.auth.uid;
      }

      // Squads are built from your friends. Four lines, and they're the
      // difference between that and "anyone can spam invites at strangers" —
      // the gap `GAPS.md` already records on friend requests, deliberately not
      // repeated here. `exists()` first because a get() on a missing document
      // fails the whole rule as an error rather than a clean denial.
      function isAcceptedFriend() {
        return exists(/databases/$(database)/documents/friendships/$(friendshipId()))
          && get(/databases/$(database)/documents/friendships/$(friendshipId()))
               .data.status == 'accepted';
      }

      // Both participants, the way `friendships` reads — the person invited,
      // and the leader who invited them. Both client listeners filter on one
      // of those two fields against the caller's own uid, so neither ever asks
      // for a document this rule doesn't already admit.
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid
            || resource.data.invitedBy == request.auth.uid);

      allow create: if isSignedIn()
        && idMatchesPair()
        && incoming().keys().hasOnly(['squadId', 'uid', 'invitedBy', 'createdAt'])
        && incoming().keys().hasAll(['squadId', 'uid', 'invitedBy', 'createdAt'])
        && incoming().squadId is string
        && incoming().squadId.size() > 0
        && incoming().uid is string
        && incoming().uid.size() > 0
        && incoming().invitedBy == request.auth.uid
        && incoming().uid != request.auth.uid
        // Only a squad's leader may invite to it — one get(), against the same
        // single identifier the rest of the feature rests on.
        && get(/databases/$(database)/documents/squads/$(incoming().squadId))
             .data.leaderId == request.auth.uid
        && isAcceptedFriend()
        && incoming().createdAt == request.time;

      // Immutable. There is nothing here to change: accepting is a write to
      // the squad, and every other outcome is a delete.
      allow update: if false;

      allow delete: if isSignedIn()
        && (resource.data.uid == request.auth.uid
            || resource.data.invitedBy == request.auth.uid);
    }

    // A squad's standing offer to play — the matchmaking pool.
    //
    // **The document ID is the squad ID**, which structurally enforces one live
    // ticket per squad. There is no duplicate-entry logic to write because
    // there is nowhere to put a second row, the same trick `friendships/{pair}`
    // uses.
    //
    // This is the one collection here written by somebody who doesn't own the
    // document: a match is committed by **both** squads' leaders in one
    // transaction — the claimer's write reaches across to spend the other
    // squad's ticket, and the two update rules below are that transaction's two
    // halves. See the commit rule's own comment for why it reads and writes
    // both tickets rather than one, and `context/plans/SEASONS.md` §2.2 for the
    // pull-with-a-lock design this replaced a single-document claim inside.
    //
    // > **Raced, not assumed.** `firestore-tests/claim-race.test.mjs` runs
    // > concurrent clients against the Firestore emulator fifteen rounds each,
    // > both shapes — two squads on one ticket, and two squads on *each other*
    // > — and asserts exactly one match survives either way, with every loser
    // > taking a transaction failure rather than leaving a half-written
    // > document. Run it with `npm run test:rules`.
    //
    // MIRRORED IN SWIFT — the court-count bounds and the ticket lifetime.
    // `hooprTests/FirestoreRulesParityTests` fails if either copy moves without
    // the other.
    match /matchTickets/{squadId} {
      function isSignedIn() { return request.auth != null; }
      function incoming() { return request.resource.data; }

      // The squad this ticket speaks for. One access, cached across every use
      // below, so pinning four denormalized fields to it costs nothing extra.
      function squad() {
        return get(/databases/$(database)/documents/squads/$(squadId)).data;
      }

      // MIRRORED IN SWIFT — `MatchTicket.courtCountRange`. One court is a squad
      // that only plays at home; eight is where a preference list stops being a
      // preference.
      function isValidCourtSelection(courtIds) {
        return courtIds is list
          && courtIds.size() >= 1
          && courtIds.size() <= 8
          // No repeats: a preference order can't rank a court against itself,
          // and a duplicate would skew the intersection the match rules take.
          && courtIds.toSet().size() == courtIds.size();
      }

      // MIRRORED IN SWIFT — `MatchTicket.lifetimeRange`. Below the floor a
      // ticket expires before anyone can see it; above the ceiling the pool
      // fills with squads who queued yesterday and went home.
      function isValidLifetime(expiresAt) {
        return expiresAt is timestamp
          && expiresAt >= request.time + duration.value(15, 'm')
          && expiresAt <= request.time + duration.value(24, 'h');
      }

      // The pool is readable by any signed-in account, like `squads`, because
      // that is what a pool *is* — every queued client watches the same one and
      // the winner of a one-document race gets the match. The pool query
      // filters on region, format, status and expiry, all of which this rule
      // already admits.
      allow read: if isSignedIn();

      // Only a squad's leader queues it, and the four denormalized fields are
      // **pinned to the squad document** rather than trusted.
      //
      // `memberIds` is the load-bearing one: it's what the no-shared-players
      // rule reads, so a client free to write its own copy could match against
      // a squad it shares players with — a person playing themselves, which is
      // the rule most worth enforcing on the server rather than hoping about.
      allow create: if isSignedIn()
        && incoming().keys().hasOnly(['squadId', 'leaderId', 'squadName',
                                      'memberIds', 'format', 'region',
                                      'courtIds', 'windowStart', 'windowEnd',
                                      'wins', 'losses', 'status',
                                      'createdAt', 'expiresAt'])
        && incoming().keys().hasAll(['squadId', 'leaderId', 'squadName',
                                     'memberIds', 'format', 'region',
                                     'courtIds', 'windowStart', 'windowEnd',
                                     'wins', 'losses', 'status',
                                     'createdAt', 'expiresAt'])
        && incoming().squadId == squadId
        && incoming().leaderId == request.auth.uid
        && squad().leaderId == request.auth.uid
        // **A burst-rate floor, not a quota.** Rules have no request counter —
        // there is no way to ask "how many squads has this uid created" — so a
        // cap on squad *count* would need a denormalized counter a modified
        // client could just decrement, which defeats the point. What rules
        // *can* enforce is a comparison against a timestamp already pinned by
        // an earlier write, which a client cannot move backwards. `squad()` is
        // already fetched for the pinned fields above, so reading its
        // `createdAt` costs nothing extra.
        //
        // This bounds how fast a *fresh* squad may enter the pool for the
        // first time — the shape that matters is one account minting many
        // disposable squads and queueing each the instant it exists, to flood
        // a region's pool past what any client's `limit(to:)` can see, or to
        // multiply how many tickets it can hold open for
        // `matchTickets.allow update`-directed transaction attempts. It does
        // nothing for the *same* squad's requeue cadence — `allow delete`
        // below carries that half — and it does nothing against a patient
        // attacker willing to space requests out. A rules-only floor can bound
        // burst rate; it cannot bound sustained abuse or survive a fresh
        // account, which need App Check and real infrastructure respectively.
        // See `context/gaps/SEASONS.md`.
        && squad().createdAt <= request.time - duration.value(5, 's')
        && incoming().memberIds == squad().memberIds
        && incoming().squadName == squad().name
        && incoming().format == squad().format
        && incoming().region == squad().region
        && isValidCourtSelection(incoming().courtIds)
        && incoming().windowStart is timestamp
        && incoming().windowEnd is timestamp
        && incoming().windowEnd > incoming().windowStart
        && incoming().windowEnd > request.time
        // The same ceiling `games` puts on a scheduled run, reused so the two
        // can't disagree about how far ahead the app plans.
        && incoming().windowStart < request.time + duration.value(30, 'd')
        && incoming().wins is int && incoming().wins >= 0
        && incoming().losses is int && incoming().losses >= 0
        // A ticket enters the pool open. `claimedBy`, `claimedAt` and
        // `matchedGameId` are absent at create — absence, never null — and only
        // the claim below may introduce the first two.
        && incoming().status == 'open'
        && isValidLifetime(incoming().expiresAt)
        && incoming().createdAt == request.time;

      // **The match commit — the one contested write in the whole feature.**
      //
      // A match is made by **one transaction that consumes both tickets and
      // creates the game**, so there is no intermediate `claimed` state and no
      // window between the two. The two `allow update` blocks below are the two
      // halves of that single commit: this one takes the *other* squad's ticket,
      // the next one closes the caller's own.
      //
      // **Why atomic, and what the two-phase version got wrong.** The old design
      // claimed one ticket, then created the game, then marked both tickets. Its
      // guarantee was Firestore serializing contested writes to a *single*
      // document — which holds, and is the wrong guarantee. Two squads that
      // claim each other touch two *different* documents, so nothing serializes
      // them, both claims win, and both clients go on to write a game. In a pool
      // of two squads that is not an edge case, it is the ordinary path, and it
      // is what put two live matches in front of both squads.
      //
      // Reading and writing **both** tickets in one transaction is what fixes
      // it: the two mutual commits now share a read set, so exactly one lands
      // and the other retries onto a ticket that is already `matched`. The
      // guarantee is the same one as before, applied to the pair that actually
      // needs it.
      //
      // `getAfter()` is what lets each half prove the other happened. The game
      // named here must exist **after this commit** and must name these two
      // squads in these two roles — so a ticket cannot be marked matched except
      // by a write that really is creating that match, and the `seasonGames`
      // create rule makes the mirror-image demand of both tickets. Neither
      // document can move without the other.
      //
      // Naming another squad is authorized by leading the squad doing the
      // claiming, which is one get() against `squads`. Nobody's uid is written
      // by anybody else here either: the only thing that changes hands is a
      // squad ID the caller already owns.
      allow update: if isSignedIn()
        && incoming().diff(resource.data).affectedKeys()
             .hasOnly(['status', 'claimedBy', 'claimedAt', 'matchedGameId'])
        && incoming().diff(resource.data).affectedKeys()
             .hasAll(['status', 'claimedBy', 'claimedAt', 'matchedGameId'])
        // **Open, and nothing else.** A ticket leaves the pool exactly once —
        // which is what stops a squad ever appearing in two live matches, and
        // is the invariant the duplicate-match bug was the absence of.
        && resource.data.status == 'open'
        && incoming().status == 'matched'
        && incoming().claimedBy is string
        // A squad can't claim itself out of the pool.
        && incoming().claimedBy != squadId
        && incoming().matchedGameId is string
        && resource.data.expiresAt > request.time
        && get(/databases/$(database)/documents/squads/$(incoming().claimedBy))
             .data.leaderId == request.auth.uid
        // The game has to exist after this commit and cast these two squads in
        // exactly these two roles — this ticket's squad at home, because it is
        // the home offer the match was built from, and the claimer away.
        && getAfter(/databases/$(database)/documents/seasonGames/$(incoming().matchedGameId))
             .data.homeSquadId == squadId
        && getAfter(/databases/$(database)/documents/seasonGames/$(incoming().matchedGameId))
             .data.awaySquadId == incoming().claimedBy
        && getAfter(/databases/$(database)/documents/seasonGames/$(incoming().matchedGameId))
             .data.status == 'scheduled'
        // Pinned, not requested — a stamp a client could backdate would make a
        // ticket's history unreadable, and `matchTickets` carries no
        // `updatedAt` for it to be checked against.
        && incoming().claimedAt == request.time;

      // **The claimer's own ticket, closed in the same commit.**
      //
      // The mirror of the block above, and the half that makes the pair atomic
      // rather than merely simultaneous: without it a squad could take an
      // opponent out of the pool while staying in it themselves, and match a
      // second squad a moment later. `claimedBy` is absent here because nobody
      // claimed this ticket — its own leader spent it.
      allow update: if isSignedIn()
        && incoming().diff(resource.data).affectedKeys()
             .hasOnly(['status', 'matchedGameId'])
        && incoming().diff(resource.data).affectedKeys()
             .hasAll(['status', 'matchedGameId'])
        && resource.data.status == 'open'
        && incoming().status == 'matched'
        && incoming().matchedGameId is string
        && resource.data.leaderId == request.auth.uid
        && getAfter(/databases/$(database)/documents/seasonGames/$(incoming().matchedGameId))
             .data.awaySquadId == squadId
        && getAfter(/databases/$(database)/documents/seasonGames/$(incoming().matchedGameId))
             .data.awayLeaderId == request.auth.uid
        && getAfter(/databases/$(database)/documents/seasonGames/$(incoming().matchedGameId))
             .data.status == 'scheduled';

      // Leaving the queue. The leader's alone, and a delete rather than a
      // status: absence, never null, the same move `friendships` makes.
      // An abandoned ticket also ages out on `expiresAt` without anyone having
      // to remove it.
      //
      // **A floor on the ticket's own age, mirroring the create-side one
      // above.** Once deleted a ticket leaves nothing behind to read a
      // timestamp from — a delete-then-immediately-recreate cooldown can't be
      // checked *after* the delete, so it has to be checked *before* it, as a
      // condition on the delete itself. `resource.data.createdAt` is
      // server-pinned at create and every subsequent write to this document
      // only ever moves `status`/`claimedBy`/`claimedAt`/`matchedGameId`, so a
      // client cannot backdate it to shorten the wait.
      //
      // This is the half the create-side floor above explicitly doesn't cover:
      // the *same* squad churning its own ticket — delete, recreate, delete,
      // recreate — which would otherwise be free to run as fast as the network
      // allows and would churn every other client's pool listener in that
      // region/format on each cycle. Five seconds is far below anything a
      // person correcting a mistaken court or window would notice, and it caps
      // a scripted loop at roughly 12 cycles a minute rather than unbounded.
      allow delete: if isSignedIn()
        && resource.data.leaderId == request.auth.uid
        && request.time >= resource.data.createdAt + duration.value(5, 's');
    }

    // A scheduled squad-vs-squad match — the document the whole feature exists
    // to produce.
    //
    // **This is where naming another squad becomes legal.** Every other
    // collection here enforces "a client may only ever write its own
    // membership", and this document commits six people to a game. It doesn't
    // break the rule, because it names *squad IDs*, not player uids: the away
    // leader writes one identifier they already own, and everything about the
    // home side is verified against the home squad's own ticket. Nobody's uid
    // is written by anybody else anywhere in Seasons. See
    // `context/plans/SEASONS.md` §0.3.
    //
    // **Readable by any signed-in user**, like `squads` and `matchTickets` and
    // unlike `games`, which gates on `isPublic` or roster membership. Season
    // play is public by design — records, standings and an opponent's history
    // are the point of the feature, and a squad's W-L is a query over these
    // documents. Recorded in `context/database/DATABASE_SCHEMA.md` as the
    // deliberate privacy decision it is.
    //
    // **The denormalized leader IDs are the reason the later write paths are
    // free.** Cancel costs zero document accesses because `homeLeaderId` and
    // `awayLeaderId` are already on the document — which is exactly why they
    // are verified against `squads` at create and immutable afterwards. A
    // forged one would hand the away side the home leader's own write paths.
    match /seasonGames/{gameId} {
      function isSignedIn() { return request.auth != null; }
      function incoming() { return request.resource.data; }

      // The two tickets this match spends, **as they stand after this commit**.
      //
      // `getAfter()` rather than `get()`, because the commit that creates this
      // match is the same commit that marks both tickets `matched` — a `get()`
      // here would read the pre-commit `open` and prove nothing. One access
      // each, cached across every use below.
      //
      // Reading both is what pins a match to *two* spent tickets rather than
      // one. The old rule proved only that the home ticket had been claimed,
      // which left the away squad free to be in a second match at the same
      // time; `matchTickets` and `seasonGames` now demand each other in both
      // directions, so neither can move alone.
      function homeTicket() {
        return getAfter(/databases/$(database)/documents/matchTickets/$(incoming().homeSquadId)).data;
      }

      function awayTicket() {
        return getAfter(/databases/$(database)/documents/matchTickets/$(incoming().awaySquadId)).data;
      }

      function squad(id) {
        return get(/databases/$(database)/documents/squads/$(id)).data;
      }

      // MARK: Reporting helpers — plan §3's mutual confirmation, as predicates.

      // A report names one of the two squads in this match. `homeSquadId` and
      // `awaySquadId` are read off `resource` rather than `request` because the
      // report path can't touch them, so they are the same two either way — and
      // reading the stored ones is what makes that obvious.
      function namesASquadInThisMatch(report) {
        return report == resource.data.homeSquadId
          || report == resource.data.awaySquadId;
      }

      // Absent is legitimate: it's how a leader clears their own report on the
      // way to re-entering it, which is §3's stated way out of a dispute.
      function homeReportIsWellFormed() {
        return !('homeReport' in incoming())
          || namesASquadInThisMatch(incoming().homeReport);
      }

      function awayReportIsWellFormed() {
        return !('awayReport' in incoming())
          || namesASquadInThisMatch(incoming().awayReport);
      }

      function bothReported() {
        return 'homeReport' in incoming() && 'awayReport' in incoming();
      }

      function reportsAgree() {
        return bothReported() && incoming().homeReport == incoming().awayReport;
      }

      // **`status` is derived from the two reports, never chosen**, the same
      // principle `games`' open/full and `matchTickets`' pool states follow.
      //
      // And `result` is only ever a value **both stored reports name**. Both
      // comparisons read `incoming()`, i.e. the document as it will be after
      // this write — so a client that sets `result` to a winner its own report
      // doesn't name, or claims an agreement the other leader never made, is
      // refused rather than believed. That single pair of comparisons is what
      // makes forging a win take two colluding squads instead of one client.
      function derivedResultHolds() {
        return reportsAgree()
          ? (incoming().status == 'confirmed'
             && incoming().result == incoming().homeReport
             && incoming().result == incoming().awayReport
             && incoming().confirmedAt == request.time)
          : (incoming().status == (bothReported() ? 'disputed' : 'scheduled')
             && !('result' in incoming())
             && !('confirmedAt' in incoming()));
      }

      // MIRRORED IN SWIFT — `SeasonGame.reportOutcome`. The client derives the
      // same three states from the same two fields, which is what lets a report
      // be checked before it's sent.

      // The keys one leader's report write may move: **their own report**, plus
      // the derived fields the very same write lands when it completes a
      // matching pair. The *other* leader's report is absent from the list, and
      // that absence is the whole pinning — the same "a client may only ever
      // write its own lane" principle `games` and `squads` build on, applied to
      // a report instead of a roster slot.
      //
      // `hasAll` is what stops this path being a general-purpose write on
      // somebody else's match: without it, a bare `updatedAt` bump would be a
      // legal "report" that moved no report at all.
      function movesOnlyOwnReport(field) {
        return incoming().diff(resource.data).affectedKeys()
                 .hasOnly([field, 'homeScore', 'awayScore',
                           'result', 'status', 'confirmedAt', 'updatedAt'])
          && incoming().diff(resource.data).affectedKeys().hasAll([field]);
      }

      allow read: if isSignedIn();

      // Four document accesses: both tickets and both squads. Rules lookups
      // against the same path within one evaluation are cached, so the repeated
      // homeTicket() and awayTicket() calls below cost nothing extra — four of
      // the ten the platform allows.
      allow create: if isSignedIn()
        && incoming().keys().hasOnly(['id', 'format', 'region',
                                      'homeSquadId', 'awaySquadId', 'squadIds',
                                      'homeLeaderId', 'awayLeaderId',
                                      'homeSquadName', 'awaySquadName',
                                      'courtId', 'scheduledTime', 'status',
                                      'arrivedPlayerIds', 'createdBy',
                                      'createdAt', 'updatedAt'])
        && incoming().keys().hasAll(['id', 'format', 'region',
                                     'homeSquadId', 'awaySquadId', 'squadIds',
                                     'homeLeaderId', 'awayLeaderId',
                                     'homeSquadName', 'awaySquadName',
                                     'courtId', 'scheduledTime', 'status',
                                     'arrivedPlayerIds', 'createdBy',
                                     'createdAt', 'updatedAt'])
        // `result`, `homeReport`, `awayReport`, `homeScore`, `awayScore`,
        // `cancelledBySquadId` and `confirmedAt` are absent from the allowlist,
        // so a match cannot be born already won. Absence, never null.
        && incoming().id == gameId
        && incoming().createdBy == request.auth.uid
        && incoming().awayLeaderId == request.auth.uid
        && incoming().homeSquadId != incoming().awaySquadId
        // Order matters: the array-contains query field is built as
        // [home, away] and the rule pins that exact shape.
        && incoming().squadIds == [incoming().homeSquadId, incoming().awaySquadId]

        // **Proves both tickets were spent, on this match, in this commit.**
        // The condition that authorizes naming another squad at all: the home
        // ticket says it is matched, matched to *this* game, and claimed by
        // *us* — and the away ticket says the same, under the leader making
        // this write. Each ticket's own rule only permits `open` -> `matched`,
        // so a ticket can be spent exactly once and a squad can therefore be in
        // exactly one live match.
        && homeTicket().status == 'matched'
        && homeTicket().claimedBy == incoming().awaySquadId
        && homeTicket().matchedGameId == gameId
        && awayTicket().status == 'matched'
        && awayTicket().matchedGameId == gameId
        && awayTicket().leaderId == request.auth.uid

        // The court and the time must be ones the home squad actually offered.
        // Both clients derive these from the same pure function, but agreement
        // is not the guarantee — this is. A modified client cannot schedule you
        // somewhere you never said you would go, or at an hour you never said
        // you were free.
        && homeTicket().courtIds.hasAll([incoming().courtId])
        && incoming().scheduledTime >= homeTicket().windowStart
        && incoming().scheduledTime <= homeTicket().windowEnd
        && incoming().scheduledTime > request.time
        && incoming().format == homeTicket().format
        && incoming().region == homeTicket().region

        // The away side's offer is checked too, now that reading its ticket is
        // already paid for. Tip-off comes from the *overlap* of the two
        // windows, so it falls inside both by construction — asserting it makes
        // that a guarantee rather than a property of the client that computed
        // it. The court deliberately isn't pinned to the away list: relaxation
        // lets a guest travel to a home court it never named, and a rule that
        // forbade that would refuse matches `MatchRules` is built to make.
        && incoming().scheduledTime >= awayTicket().windowStart
        && incoming().scheduledTime <= awayTicket().windowEnd
        && incoming().format == awayTicket().format
        && incoming().region == awayTicket().region

        // Verified once, here, because every later write trusts them for free.
        && squad(incoming().homeSquadId).leaderId == incoming().homeLeaderId
        && squad(incoming().homeSquadId).name == incoming().homeSquadName
        && squad(incoming().awaySquadId).leaderId == request.auth.uid
        && squad(incoming().awaySquadId).name == incoming().awaySquadName

        && incoming().status == 'scheduled'
        && incoming().arrivedPlayerIds == []
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Cancellation — **either leader**, and only from `scheduled`.
      //
      // Zero document accesses: the leader IDs were verified at create and are
      // immutable, so this reads them straight off the document. A leader may
      // only cancel *as their own squad*, which is what keeps
      // `cancelledBySquadId` an honest record of who called it off rather than
      // a field either side can point at the other.
      //
      // A match nobody could call off would sit on both squads' home screens
      // forever — the same argument `games` makes for cancellation. It is an
      // update rather than a delete because a cancelled match is still history
      // both squads should be able to see.
      allow update: if isSignedIn()
        && incoming().diff(resource.data).affectedKeys()
             .hasOnly(['status', 'cancelledBySquadId', 'updatedAt'])
        && resource.data.status == 'scheduled'
        && incoming().status == 'cancelled'
        && ((request.auth.uid == resource.data.homeLeaderId
             && incoming().cancelledBySquadId == resource.data.homeSquadId)
            || (request.auth.uid == resource.data.awayLeaderId
                && incoming().cancelledBySquadId == resource.data.awaySquadId))
        && incoming().updatedAt == request.time;

      // Arrival — self-add only, either squad. Screen 7's "We're here."
      //
      // The `games` self-only membership pattern verbatim: the diff is exactly
      // the caller's own uid, added, and never removed — there is no "un-
      // arrive", the same way marking a run `completed` has no undo. **The
      // no-duplicates check is not optional**; the reason is documented on
      // `squads` and hasn't changed — without it, a set diff reads a list of
      // one uid repeated as no change at all.
      //
      // The caller has to be on one of the two rosters, which costs two
      // `get()`s against `squads` — well inside the ten-access ceiling next to
      // the create rule's three, and cheap because both are cached if this
      // write ever needs them twice.
      allow update: if isSignedIn()
        && incoming().diff(resource.data).affectedKeys().hasOnly(['arrivedPlayerIds'])
        && resource.data.status == 'scheduled'
        && incoming().arrivedPlayerIds is list
        && incoming().arrivedPlayerIds.toSet().size() == incoming().arrivedPlayerIds.size()
        && incoming().arrivedPlayerIds.toSet()
             .difference(resource.data.arrivedPlayerIds.toSet())
             .hasOnly([request.auth.uid])
        && resource.data.arrivedPlayerIds.toSet()
             .difference(incoming().arrivedPlayerIds.toSet()).size() == 0
        && !(request.auth.uid in resource.data.arrivedPlayerIds)
        && incoming().arrivedPlayerIds.hasAll([request.auth.uid])
        && (request.auth.uid in squad(resource.data.homeSquadId).memberIds
            || request.auth.uid in squad(resource.data.awaySquadId).memberIds);

      // Reporting — plan §3's mutual confirmation, and the reason a squad's
      // record is worth believing without a server to keep it honest.
      //
      // A third `allow update`, separate from cancel and arrival, following the
      // same one-write-one-path split those two already establish: a report can
      // never smuggle in a cancellation, and an arrival can never smuggle in a
      // result.
      //
      // **Zero document accesses**, like cancel. Both leader IDs were verified
      // against `squads` at create and are immutable, so the pinning below
      // reads them straight off the document — which is the entire payoff for
      // denormalizing them, and exactly why a forged one is refused at create.
      //
      // **Re-reporting is this same path, called again.** §3's stated way out
      // of a disagreement is a leader clearing their own report and re-entering
      // it, so `disputed` is a reportable starting state and an existing report
      // may be overwritten or cleared. A rule that only permitted absent →
      // present would leave a disputed match disputed forever, with the
      // design's own recovery path unreachable.
      //
      // **`confirmed` is deliberately not reportable.** A leader able to
      // re-report a match both sides already agreed on could turn their own
      // loss back into a dispute unilaterally — strictly weaker than the
      // rec-league scoresheet standard §3 claims to meet, and not something the
      // recovery path needs. `cancelled` is out for the same reason it is out
      // of every other path here: a called-off match has no result.
      // **A floor on re-reporting, scoped to one leader's own field — not the
      // document.** Nothing otherwise stops a leader clearing and re-entering
      // their own report as fast as the network allows, bouncing the match
      // between `scheduled` and `disputed` and churning the opponent's
      // listener on every cycle.
      //
      // **It has to be per-field, or it breaks the feature's own happy path.**
      // A document-wide floor on `resource.data.updatedAt` looked right at
      // first and is wrong: mutual confirmation's ordinary case is two
      // *different* leaders each reporting for the first time within moments
      // of each other — two people standing on the same court, both opening
      // the app right after the final basket — and a floor keyed to "was this
      // document touched recently, by anyone" would refuse the second
      // leader's first-ever report for the crime of arriving promptly.
      // `firestore-tests/results.test.mjs` is full of exactly that sequence,
      // which is what caught this before it shipped.
      //
      // The fix is asking a narrower question: was *this leader's own field*
      // already present before this write? If not, this is their first report
      // and nothing should slow it down, however soon after the other
      // leader's. If so, this is a re-touch of a report already on record —
      // clearing it, changing it, or re-entering it — and that's the write
      // worth spacing out.
      function reportCooldownElapsed(field) {
        return !(field in resource.data)
          || request.time >= resource.data.updatedAt + duration.value(5, 's');
      }

      allow update: if isSignedIn()
        && (resource.data.status == 'scheduled' || resource.data.status == 'disputed')
        // A match cannot be reported before it has been played. Plan §3's
        // "after `scheduledTime`", enforced rather than assumed.
        && request.time >= resource.data.scheduledTime
        // Each report field is pinned to its own leader, in both directions,
        // and each leader's cooldown is checked against their own field only —
        // never the other leader's, and never the document as a whole.
        && ((request.auth.uid == resource.data.homeLeaderId
             && movesOnlyOwnReport('homeReport')
             && reportCooldownElapsed('homeReport'))
            || (request.auth.uid == resource.data.awayLeaderId
                && movesOnlyOwnReport('awayReport')
                && reportCooldownElapsed('awayReport')))
        && homeReportIsWellFormed()
        && awayReportIsWellFormed()
        // Cosmetic and explicitly not part of the record — the scoresheet
        // beside the result, never the result itself.
        && (!('homeScore' in incoming())
            || (incoming().homeScore is int && incoming().homeScore >= 0))
        && (!('awayScore' in incoming())
            || (incoming().awayScore is int && incoming().awayScore >= 0))
        && derivedResultHolds()
        && incoming().updatedAt == request.time;

      // **No delete, ever.** A squad's record is a query over these documents,
      // so a deletable match is a forgeable record — which is the entire thing
      // the derived-record design exists to prevent. Cancelling is the exit,
      // and a cancelled match is structurally excluded from the record because
      // it never reaches `confirmed`.
      allow delete: if false;
    }
  }
}
